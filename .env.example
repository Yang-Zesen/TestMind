APP_HOST=127.0.0.1
APP_PORT=26104
# Copy to .env and replace placeholders with local credentials.
POSTGRES_DSN=postgresql://testmind:replace_me@localhost:5432/testmind
# Knowledge routes fail closed unless a trusted auth provider is configured.
APP_ENV=development
KNOWLEDGE_AUTH_MODE=disabled
# Set mock only for local development; permissions are fixed server-side values.
KNOWLEDGE_MOCK_USER_ID=dev-user
KNOWLEDGE_MOCK_PROJECT_IDS=
KNOWLEDGE_MOCK_BASE_IDS=
KNOWLEDGE_SOURCE_DIR=data/knowledge-sources
KNOWLEDGE_MAX_UPLOAD_BYTES=26214400
ZENTAO_EVENT_ENABLED=false
ZENTAO_EVENT_SECRET=

# ZenTao API base URL and HTTP Basic gateway credentials.
ZENTAO_BASE_URL=http://127.0.0.1/zentao
ZENTAO_MCP_ENABLED=false
ZENTAO_MCP_URL=http://127.0.0.1:9090/zentao/mcp
ZENTAO_MCP_TIMEOUT_SECONDS=20
ZENTAO_USER_CACHE=zentao
ZENTAO_PASSWORD_CACHE=
# ZenTao application accounts; keep passwords in the ignored local .env.
ZENTAO_USER_ADMIN=admin
ZENTAO_PASSWORD_ADMIN=
ZENTAO_USER_TEST=TE1
ZENTAO_PASSWORD_TEST=
ZENTAO_USER_DEV=RD1
ZENTAO_PASSWORD_DEV=

# Independent relation synchronization (disabled until explicitly configured)
GRAPH_SYNC_ENABLED=false
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_DATABASE=neo4j
NEO4J_READ_USER=
NEO4J_READ_PASSWORD=
NEO4J_WRITE_USER=
NEO4J_WRITE_PASSWORD=
GRAPH_SOURCE_INSTANCE=zentao
GRAPH_EVENT_SECRET=
GRAPH_PROJECT_MAPPING={}
GRAPH_SNAPSHOT_URL=
GRAPH_SNAPSHOT_TOKEN=
KNOWLEDGE_STORAGE_MODE=filesystem
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=testmind-knowledge
MINIO_SECURE=true
JEV_API_KEY=replace_me
JEV_BASE_URL=https://jevmodel.org
JEV_MODEL=jev-latest
BGE_M3_PATH=pretrained_model/bge-m3
BGE_DEVICE=cpu
BGE_FP16=False
BGE_RERANKER_BASE=pretrained_model/bge-reranker-base
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_FP16=False
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=testmind_chunks
MILVUS_TIMEOUT_SECONDS=5
RETRIEVAL_TIMEOUT_SECONDS=60
RETRIEVAL_MIN_RELEVANCE=0.5
DIALOGUE_TIMEOUT_SECONDS=60
AI_NODE_TIMEOUT_SECONDS=60
