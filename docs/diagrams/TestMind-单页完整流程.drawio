<mxfile host="Electron" deliveryScope="local-demo-P0-P6-20261014" completionBasis="Local demo acceptance only; real BGE and PG-Milvus-Neo4j, simulated identity and ZenTao; fixed retrieval evaluation 3/4; production targets retain independent status">
  <diagram id="testmind-single-page" name="TestMind 单页完整流程">
    <mxGraphModel dx="14031" dy="2063" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="10600" pageHeight="11700" math="0" shadow="0">
