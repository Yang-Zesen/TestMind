# Local demonstration only. These services publish on loopback.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=26104
POSTGRES_DSN=postgresql://testmind@127.0.0.1:15432/testmind
GRAPH_SYNC_DSN=postgresql://testmind@127.0.0.1:15432/testmind
TESTMIND_DEMO_MODE=true
KNOWLEDGE_AUTH_MODE=demo
KNOWLEDGE_MOCK_USER_ID=demo-user
KNOWLEDGE_MOCK_PROJECT_IDS=demo-project
KNOWLEDGE_MOCK_BASE_IDS=demo-kb
KNOWLEDGE_STORAGE_MODE=filesystem
KNOWLEDGE_SOURCE_DIR=data/demo-sources
MILVUS_URI=http://127.0.0.1:29530
MILVUS_COLLECTION=testmind_demo_chunks
MILVUS_DENSE_METRIC=COSINE
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
TESTMIND_PRELOAD_RAG=true
NEO4J_URI=bolt://127.0.0.1:17687
NEO4J_DATABASE=neo4j
GRAPH_SYNC_ENABLED=true
ZENTAO_MCP_ENABLED=false
