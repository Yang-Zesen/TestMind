        <mxCell id="start" deliveryScope="core" implementationStatus="not_verified" parent="1" previousValue="开始 / 用户输入" style="ellipse;align=left;whiteSpace=wrap;html=1;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=15;spacing=16;fillColor=#ffffff;strokeColor=#98a2b3;strokeWidth=2;shadow=0;fontColor=#182230;" value="开始 / 用户输入" vertex="1">
