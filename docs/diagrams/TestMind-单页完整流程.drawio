          </mxGeometry>
        </mxCell>
        <mxCell id="mvp-entry" deliveryScope="deferred" implementationStatus="not_verified" parent="1" prdRefs="F-08,F-09,F-31" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;spacing=16;strokeColor=#c62828;fillColor=#fff0f0;fontColor=#a51e1e;strokeWidth=2;" value="&lt;b&gt;后续快捷入口：明确选择 API 用例任务&lt;/b&gt;&lt;br&gt;用户选择业务类型，可跳过自然语言识别&lt;br&gt;统一鉴权、来源校验与审批仍须执行&lt;br&gt;主入口恢复拼写纠错、意图识别及按意图路由" vertex="1">
          <mxGeometry height="210" width="620" x="4200" y="1230" as="geometry" />
        </mxCell>
        <mxCell id="joWmhu-DPa3gcet3B-iL-23" edge="1" parent="1" source="mvp-clarify" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" target="s1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="joWmhu-DPa3gcet3B-iL-25" connectable="0" parent="joWmhu-DPa3gcet3B-iL-23" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" value="补齐后返回" vertex="1">
          <mxGeometry relative="1" x="0.1333" y="3" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="mvp-clarify" deliveryScope="core" implementationStatus="not_verified" parent="1" prdRefs="F-08,F-11,F-31,F-32" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;spacing=16;strokeColor=#98a2b3;fillColor=#ffffff;fontColor=#182230;strokeWidth=2;" value="&lt;b&gt;[HITL] 补充资料与恢复原任务&lt;/b&gt;&lt;br&gt;解析失败、冲突、过期或信息不足则停止生成&lt;br&gt;返回缺项和来源位置；补齐后恢复同一 task_id&lt;br&gt;拒绝 / 取消也记终态；不得编造约束&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;纳入范围 | F-08,F-11,F-31,F-32&lt;/font&gt;" vertex="1">
          <mxGeometry height="180" width="600" x="1690" y="3145" as="geometry" />
        </mxCell>
        <mxCell id="mvp-preflight" deliveryScope="deferred" implementationStatus="not_verified" parent="1" prdRefs="F-16,F-41,F-46,F-47,F-48" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;spacing=16;strokeColor=#c62828;fillColor=#fff0f0;fontColor=#a51e1e;strokeWidth=2;" value="&lt;b&gt;运行前环境与数据门禁&lt;/b&gt;&lt;br&gt;登记一个授权环境：地址、版本、依赖、负责人&lt;br&gt;检查连通性 / 版本、参数；任务独立数据命名空间&lt;br&gt;复核审批 hash、环境 / 数据版本与权限；失败阻断&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;暂缓 | F-16,F-41,F-46,F-47,F-48&lt;/font&gt;" vertex="1">
          <mxGeometry height="180" width="620" x="3300" y="4105" as="geometry" />
        </mxCell>
        <mxCell id="p39" deliveryScope="deferred" implementationStatus="not_verified" parent="1" prdRefs="F-39,F-40" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;spacing=16;strokeColor=#c62828;fillColor=#fff0f0;fontColor=#a51e1e;strokeWidth=2;" value="&lt;b&gt;[AI] 测试策略与计划草稿&lt;/b&gt;&lt;br&gt;需求 / 开发澄清 / 风险 / 质量目标&lt;br&gt;范围、类型、优先级、覆盖、进入退出准则&lt;br&gt;环境 / 数据需求；信息不足回澄清&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;暂缓 | F-39,F-40&lt;/font&gt;" vertex="1">
          <mxGeometry height="200" width="1180" x="5080" y="2935" as="geometry" />
        </mxCell>
        <mxCell id="p39-review" deliveryScope="deferred" implementationStatus="not_verified" parent="1" prdRefs="F-39,F-40" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;spacing=16;strokeColor=#c62828;fillColor=#fff0f0;fontColor=#a51e1e;strokeWidth=2;" value="&lt;b&gt;[HITL] 策略评审与计划基线&lt;/b&gt;&lt;br&gt;责任人编辑、评审、批准，保留版本&lt;br&gt;策略项关联需求 / 风险，再驱动测试设计&lt;br&gt;计划触发不得替代审批或执行授权&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;暂缓 | F-39,F-40&lt;/font&gt;" vertex="1">
          <mxGeometry height="200" width="1180" x="5080" y="3225" as="geometry" />
        </mxCell>
        <mxCell id="p40" deliveryScope="deferred" implementationStatus="not_verified" parent="1" prdRefs="F-40" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;spacing=16;strokeColor=#c62828;fillColor=#fff0f0;fontColor=#a51e1e;strokeWidth=2;" value="&lt;b&gt;端到端计划状态与人工执行&lt;/b&gt;&lt;br&gt;关联策略、用例、环境、数据、任务、缺陷、回归、报告&lt;br&gt;展示依赖、责任人、阻塞、变更影响和未执行项&lt;br&gt;人工测试记录实际结果 / 证据；不伪装自动执行&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;暂缓 | F-40&lt;/font&gt;" vertex="1">
          <mxGeometry height="200" width="1180" x="5080" y="3515" as="geometry" />
        </mxCell>
        <mxCell id="p50-draft" deliveryScope="deferred" implementationStatus="not_verified" parent="1" prdRefs="F-50" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;spacing=16;strokeColor=#c62828;fillColor=#fff0f0;fontColor=#a51e1e;strokeWidth=2;" value="&lt;b&gt;[AI] 全量测试报告草稿&lt;/b&gt;&lt;br&gt;范围 / 覆盖、环境 / 数据版本、进度、缺陷与回归&lt;br&gt;列出未执行项、限制、残余风险和证据引用&lt;br&gt;指标来自结构化记录，不补造结果&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;暂缓 | F-50&lt;/font&gt;" vertex="1">
          <mxGeometry height="200" width="1180" x="5080" y="3805" as="geometry" />
        </mxCell>
        <mxCell id="p50-review" deliveryScope="deferred" implementationStatus="not_verified" parent="1" prdRefs="F-50" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;spacing=16;strokeColor=#c62828;fillColor=#fff0f0;fontColor=#a51e1e;strokeWidth=2;" value="&lt;b&gt;[HITL] 报告评审与修订&lt;/b&gt;&lt;br&gt;责任人审核结论、证据和退出标准&lt;br&gt;退回或批准；保留意见与报告版本&lt;br&gt;未经评审只能显示草稿&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;暂缓 | F-50&lt;/font&gt;" vertex="1">
          <mxGeometry height="200" width="1180" x="5080" y="4095" as="geometry" />
        </mxCell>
        <mxCell id="p50-publish" deliveryScope="deferred" implementationStatus="not_verified" parent="1" prdRefs="F-25,F-50" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;spacing=16;strokeColor=#c62828;fillColor=#fff0f0;fontColor=#a51e1e;strokeWidth=2;" value="&lt;b&gt;正式报告发布 / 导出&lt;/b&gt;&lt;br&gt;访问 / 导出重新授权；撤权立即不可读&lt;br&gt;保存发布版本、责任人、时间和审计&lt;br&gt;下钻 task / run / 资产 / 缺陷 / 证据&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;暂缓 | F-25,F-50&lt;/font&gt;" vertex="1">
          <mxGeometry height="200" width="1180" x="5080" y="4385" as="geometry" />
        </mxCell>
        <mxCell id="p46-change" deliveryScope="deferred" implementationStatus="not_verified" parent="1" prdRefs="F-11,F-40,F-46" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;spacing=16;strokeColor=#c62828;fillColor=#fff0f0;fontColor=#a51e1e;strokeWidth=2;" value="&lt;b&gt;契约 / 需求变更影响与复核&lt;/b&gt;&lt;br&gt;识别版本变化，定位受影响策略 / 用例 / 脚本&lt;br&gt;标记过期基线，提示复核；变更须重新批准&lt;br&gt;保留旧版本证据，不覆盖历史运行&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;暂缓 | F-11,F-40,F-46&lt;/font&gt;" vertex="1">
          <mxGeometry height="200" width="1180" x="5080" y="4675" as="geometry" />
        </mxCell>
        <mxCell id="p47" deliveryScope="deferred" implementationStatus="not_verified" parent="1" prdRefs="F-47" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;spacing=16;strokeColor=#c62828;fillColor=#fff0f0;fontColor=#a51e1e;strokeWidth=2;" value="&lt;b&gt;环境目录与受控准备 / 清理&lt;/b&gt;&lt;br&gt;登记地址、资源、版本、依赖、负责人、访问策略&lt;br&gt;对接部署 / 容器 / 设备平台；操作先审批&lt;br&gt;维护状态、锁定 / 并发隔离、健康检查与失败审计&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;暂缓 | F-47&lt;/font&gt;" vertex="1">
          <mxGeometry height="200" width="1180" x="6520" y="2935" as="geometry" />
        </mxCell>
        <mxCell id="p41" deliveryScope="deferred" implementationStatus="not_verified" parent="1" prdRefs="F-41,F-48" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;spacing=16;strokeColor=#c62828;fillColor=#fff0f0;fontColor=#a51e1e;strokeWidth=2;" value="&lt;b&gt;[AI] 版本化测试数据集&lt;/b&gt;&lt;br&gt;按字段约束 / 因子生成正向、负向、边界数据&lt;br&gt;profile / 行级编辑 / 导入 / 校验 / 用例与环境绑定&lt;br&gt;合成数据标来源；敏感生产数据先授权脱敏&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;暂缓 | F-41,F-48&lt;/font&gt;" vertex="1">
          <mxGeometry height="200" width="1180" x="6520" y="3225" as="geometry" />
        </mxCell>
        <mxCell id="p48" deliveryScope="deferred" implementationStatus="not_verified" parent="1" prdRefs="F-48" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;spacing=16;strokeColor=#c62828;fillColor=#fff0f0;fontColor=#a51e1e;strokeWidth=2;" value="&lt;b&gt;[HITL] 数据备份、初始化、恢复与清理&lt;/b&gt;&lt;br&gt;审批用途、范围与环境；操作留证&lt;br&gt;执行前备份 / 重置；执行后恢复 / 清理并记结果&lt;br&gt;限定保留期；禁止未经审批向低安全级环境复制&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;暂缓 | F-48&lt;/font&gt;" vertex="1">
          <mxGeometry height="200" width="1180" x="6520" y="3515" as="geometry" />
        </mxCell>
        <mxCell id="p46" deliveryScope="deferred" implementationStatus="not_verified" parent="1" prdRefs="F-46" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;spacing=16;strokeColor=#c62828;fillColor=#fff0f0;fontColor=#a51e1e;strokeWidth=2;" value="&lt;b&gt;API 契约闭环扩展&lt;/b&gt;&lt;br&gt;接口同步 / 变更提示；环境变量切换与 Mock&lt;br&gt;正负边界 / 安全测试提案；断言、前后置、数据集可编辑&lt;br&gt;数据驱动、CLI / CI 获批运行与标准报告导出&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;暂缓 | F-46&lt;/font&gt;" vertex="1">
          <mxGeometry height="200" width="1180" x="6520" y="3805" as="geometry" />
        </mxCell>
        <mxCell id="p42" deliveryScope="deferred" implementationStatus="not_verified" parent="1" prdRefs="F-13,F-42,F-45" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;spacing=16;strokeColor=#c62828;fillColor=#fff0f0;fontColor=#a51e1e;strokeWidth=2;" value="&lt;b&gt;API / UI / 跨端隔离 dry-run&lt;/b&gt;&lt;br&gt;显式授权环境和验证版本；检查步骤、元素、断言和数据&lt;br&gt;保留步骤、截图、设备 / 浏览器 / 应用版本与失败原因&lt;br&gt;返回评审，不代替正式验收&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;暂缓 | F-13,F-42,F-45&lt;/font&gt;" vertex="1">
          <mxGeometry height="200" width="1180" x="6520" y="4095" as="geometry" />
        </mxCell>
        <mxCell id="p43" deliveryScope="deferred" implementationStatus="not_verified" parent="1" prdRefs="F-43" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;spacing=16;strokeColor=#c62828;fillColor=#fff0f0;fontColor=#a51e1e;strokeWidth=2;" value="&lt;b&gt;受控 UI 定位器自愈&lt;/b&gt;&lt;br&gt;策略显式开启；只修定位器且只作用当前运行&lt;br&gt;记录旧 / 新值、轨迹、结果、影响；人工批准才更新基线&lt;br&gt;禁止改业务断言、预期、API 参数或安全策略&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;暂缓 | F-43&lt;/font&gt;" vertex="1">
          <mxGeometry height="200" width="1180" x="6520" y="4385" as="geometry" />
        </mxCell>
        <mxCell id="p30" deliveryScope="deferred" implementationStatus="not_verified" parent="1" prdRefs="F-16,F-30" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;spacing=16;strokeColor=#c62828;fillColor=#fff0f0;fontColor=#a51e1e;strokeWidth=2;" value="&lt;b&gt;获批性能任务与工具报告&lt;/b&gt;&lt;br&gt;授权环境、负载范围、资源限制；适配 Locust 等工具&lt;br&gt;记录工具 / 版本、目标、run_id、覆盖与原始报告&lt;br&gt;未运行显示未采集；不完整不得报告通过&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;暂缓 | F-16,F-30&lt;/font&gt;" vertex="1">
          <mxGeometry height="200" width="1480" x="7980" y="5115" as="geometry" />
        </mxCell>
        <mxCell id="p18" deliveryScope="deferred" implementationStatus="not_verified" parent="1" prdRefs="F-18,F-45" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;spacing=16;strokeColor=#c62828;fillColor=#fff0f0;fontColor=#a51e1e;strokeWidth=2;" value="&lt;b&gt;[AI] 失败分析与统一证据快照&lt;/b&gt;&lt;br&gt;关联步骤 / 断言 / 响应 / 日志 / 截图 / 视频&lt;br&gt;绑定 run_id、应用 / 用例 / 环境版本和时间&lt;br&gt;输出根因假设、证据、可信度；可保持未定&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;暂缓 | F-18,F-45&lt;/font&gt;" vertex="1">
          <mxGeometry height="200" width="1180" x="9740" y="2935" as="geometry" />
        </mxCell>
        <mxCell id="p19" deliveryScope="deferred" implementationStatus="not_verified" parent="1" prdRefs="F-02,F-19" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;spacing=16;strokeColor=#c62828;fillColor=#fff0f0;fontColor=#a51e1e;strokeWidth=2;" value="&lt;b&gt;[HITL] 缺陷去重、草稿与禅道提单&lt;/b&gt;&lt;br&gt;授权范围查重复 / 相关缺陷，可关联已有 ID&lt;br&gt;草稿含复现、环境、预期 / 实际和原始证据&lt;br&gt;批准后幂等写入；失败留草稿与错误&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;暂缓 | F-02,F-19&lt;/font&gt;" vertex="1">
          <mxGeometry height="200" width="1180" x="9740" y="3225" as="geometry" />
        </mxCell>
        <mxCell id="p49-impact" deliveryScope="deferred" implementationStatus="not_verified" parent="1" prdRefs="F-26,F-45,F-49" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;spacing=16;strokeColor=#c62828;fillColor=#fff0f0;fontColor=#a51e1e;strokeWidth=2;" value="&lt;b&gt;[AI] 修复关联与回归影响分析&lt;/b&gt;&lt;br&gt;关联已确认修复版本 / 变更、缺陷和原失败运行&lt;br&gt;需求-用例-接口/脚本关系驱动风险与建议套件&lt;br&gt;列出未覆盖项与选择依据&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;暂缓 | F-26,F-45,F-49&lt;/font&gt;" vertex="1">
          <mxGeometry height="200" width="1180" x="9740" y="3515" as="geometry" />
        </mxCell>
        <mxCell id="p49-review" deliveryScope="deferred" implementationStatus="not_verified" parent="1" prdRefs="F-45,F-49" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;spacing=16;strokeColor=#c62828;fillColor=#fff0f0;fontColor=#a51e1e;strokeWidth=2;" value="&lt;b&gt;[HITL] 回归集审核与受控重跑&lt;/b&gt;&lt;br&gt;负责人选择套件、环境、数据和修复版本&lt;br&gt;复核脚本授权，复用运行门禁及隔离执行&lt;br&gt;手动触发即可；不依赖定时调度&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;暂缓 | F-45,F-49&lt;/font&gt;" vertex="1">
          <mxGeometry height="200" width="1180" x="9740" y="3805" as="geometry" />
        </mxCell>
        <mxCell id="p49-compare" deliveryScope="deferred" implementationStatus="not_verified" parent="1" prdRefs="F-45,F-49" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;spacing=16;strokeColor=#c62828;fillColor=#fff0f0;fontColor=#a51e1e;strokeWidth=2;" value="&lt;b&gt;[HITL] 前后对比与关闭 / 重开&lt;/b&gt;&lt;br&gt;比较修复前、修复后及基线的真实执行证据&lt;br&gt;记录未执行、失败、残余风险和关闭 / 重开决定&lt;br&gt;未执行或部分失败不得标为回归通过&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;暂缓 | F-45,F-49&lt;/font&gt;" vertex="1">
          <mxGeometry height="200" width="1180" x="9740" y="4095" as="geometry" />
        </mxCell>
        <mxCell id="p21" deliveryScope="deferred" implementationStatus="not_verified" parent="1" prdRefs="F-20,F-21" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;spacing=16;strokeColor=#c62828;fillColor=#fff0f0;fontColor=#a51e1e;strokeWidth=2;" value="&lt;b&gt;下一轮引用与质量前后对照&lt;/b&gt;&lt;br&gt;确认资产分别脱敏、去重、授权审核后入库&lt;br&gt;下一轮实际引用有效版本并展示来源&lt;br&gt;固定样例比较质量；撤回旧版不可召回&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;暂缓 | F-20,F-21&lt;/font&gt;" vertex="1">
          <mxGeometry height="200" width="1180" x="9740" y="4385" as="geometry" />
        </mxCell>
        <mxCell id="p06" deliveryScope="deferred" implementationStatus="not_verified" parent="1" prdRefs="F-06,F-07,F-21" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;spacing=16;strokeColor=#c62828;fillColor=#fff0f0;fontColor=#a51e1e;strokeWidth=2;" value="&lt;b&gt;检索方案评估与验收&lt;/b&gt;&lt;br&gt;比较向量、BM25 混合、重排；去重 / Top-K 可配&lt;br&gt;现有 BGE 稀疏向量不等同 BM25，须分别验证&lt;br&gt;独立版本化评估集不混入知识 / 训练数据&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;暂缓 | F-06,F-07,F-21&lt;/font&gt;" vertex="1">
          <mxGeometry height="200" width="1180" x="3920" y="7835" as="geometry" />
        </mxCell>
        <mxCell id="p33" deliveryScope="deferred" implementationStatus="not_verified" parent="1" prdRefs="F-30,F-33" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;spacing=16;strokeColor=#c62828;fillColor=#fff0f0;fontColor=#a51e1e;strokeWidth=2;" value="&lt;b&gt;[HITL] 安全测试授权与目标范围&lt;/b&gt;&lt;br&gt;授权人、资产、项目、方法、排除项、环境、有效期、限制&lt;br&gt;未授权 / 越界 / 过期拒绝；禁止未授权生产 / 第三方主动测试&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;暂缓 | F-30,F-33&lt;/font&gt;" vertex="1">
          <mxGeometry height="200" width="1480" x="7980" y="2945" as="geometry" />
        </mxCell>
        <mxCell id="p34" deliveryScope="deferred" implementationStatus="not_verified" parent="1" prdRefs="F-16,F-30,F-34" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;spacing=16;strokeColor=#c62828;fillColor=#fff0f0;fontColor=#a51e1e;strokeWidth=2;" value="&lt;b&gt;安全工具适配与隔离派发&lt;/b&gt;&lt;br&gt;Web/API、OpenAPI/Postman、代码变更范围&lt;br&gt;获批 DAST / AI 安全工具；保存工具版本、配置、目标、run_id&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;暂缓 | F-16,F-30,F-34&lt;/font&gt;" vertex="1">
          <mxGeometry height="200" width="1480" x="7980" y="3255" as="geometry" />
        </mxCell>
        <mxCell id="p35" deliveryScope="deferred" implementationStatus="not_verified" parent="1" prdRefs="F-35" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;spacing=16;strokeColor=#c62828;fillColor=#fff0f0;fontColor=#a51e1e;strokeWidth=2;" value="&lt;b&gt;安全发现、证据与验证等级&lt;/b&gt;&lt;br&gt;严重度、CWE/OWASP、位置、影响、复现/PoC、建议与来源&lt;br&gt;区分已验证、待验证、误报、无法判断；模型推断不是已验证漏洞&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;暂缓 | F-35&lt;/font&gt;" vertex="1">
          <mxGeometry height="200" width="1480" x="7980" y="3565" as="geometry" />
        </mxCell>
        <mxCell id="p36" deliveryScope="deferred" implementationStatus="not_verified" parent="1" prdRefs="F-36" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;spacing=16;strokeColor=#c62828;fillColor=#fff0f0;fontColor=#a51e1e;strokeWidth=2;" value="&lt;b&gt;覆盖、限制与真实运行状态&lt;/b&gt;&lt;br&gt;记录实际目标、排除项、策略、时间和原始报告&lt;br&gt;预算耗尽 / 超时 / 不可达 / 中断标为部分或失败；无发现不等于通过&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;暂缓 | F-36&lt;/font&gt;" vertex="1">
          <mxGeometry height="200" width="1480" x="7980" y="3875" as="geometry" />
        </mxCell>
        <mxCell id="p37" deliveryScope="deferred" implementationStatus="not_verified" parent="1" prdRefs="F-19,F-37" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;spacing=16;strokeColor=#c62828;fillColor=#fff0f0;fontColor=#a51e1e;strokeWidth=2;" value="&lt;b&gt;[HITL] 安全修复、提单与复测&lt;/b&gt;&lt;br&gt;确认后提缺陷草稿；候选补丁交代码负责人审核&lt;br&gt;相同目标和可比配置复测，留前后证据；满足规则才关闭&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;暂缓 | F-19,F-37&lt;/font&gt;" vertex="1">
          <mxGeometry height="200" width="1480" x="7980" y="4185" as="geometry" />
        </mxCell>
        <mxCell id="p38" deliveryScope="deferred" implementationStatus="not_verified" parent="1" prdRefs="F-25,F-38" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;spacing=16;strokeColor=#c62828;fillColor=#fff0f0;fontColor=#a51e1e;strokeWidth=2;" value="&lt;b&gt;安全 CI / PR 门禁、导出与审计&lt;/b&gt;&lt;br&gt;按严重度、验证等级、任务完成状态决定门禁&lt;br&gt;未知 / 未完成不默认放行；审批、调用、访问和导出留审计&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;暂缓 | F-25,F-38&lt;/font&gt;" vertex="1">
          <mxGeometry height="200" width="1480" x="7980" y="4495" as="geometry" />
        </mxCell>
        <mxCell id="psec-return" deliveryScope="deferred" implementationStatus="not_verified" parent="1" prdRefs="F-30,F-37,F-40,F-50" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;spacing=16;strokeColor=#c62828;fillColor=#fff0f0;fontColor=#a51e1e;strokeWidth=2;" value="&lt;b&gt;安全结果汇入计划 / 报告 / 反馈&lt;/b&gt;&lt;br&gt;保留工具来源与验证等级；项目权限内展示&lt;br&gt;修复建议需审核；安全结果不替代功能回归&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;暂缓 | F-30,F-37,F-40,F-50&lt;/font&gt;" vertex="1">
          <mxGeometry height="200" width="1480" x="7980" y="4805" as="geometry" />
        </mxCell>
        <mxCell id="p22" deliveryScope="deferred" implementationStatus="not_verified" parent="1" prdRefs="F-22" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;spacing=16;strokeColor=#c62828;fillColor=#fff0f0;fontColor=#a51e1e;strokeWidth=2;" value="&lt;b&gt;根因分类与训练数据准入&lt;/b&gt;&lt;br&gt;代码 / 环境 / 数据 / 配置 / 用例分类；人工标注规则可追溯&lt;br&gt;授权、脱敏、去重；训练 / 验证 / 测试隔离；知识准入单独审批&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;暂缓 | F-22&lt;/font&gt;" vertex="1">
          <mxGeometry height="200" width="1480" x="3920" y="7005" as="geometry" />
        </mxCell>
        <mxCell id="p23" deliveryScope="deferred" implementationStatus="not_verified" parent="1" prdRefs="F-23" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;spacing=16;strokeColor=#c62828;fillColor=#fff0f0;fontColor=#a51e1e;strokeWidth=2;" value="&lt;b&gt;失败分类模型评估、发布与回滚&lt;/b&gt;&lt;br&gt;独立评估集、版本、适用范围和质量门槛；未达标不发布&lt;br&gt;留评估证据、置信度与回滚；新反馈不自动替换模型&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;暂缓 | F-23&lt;/font&gt;" vertex="1">
          <mxGeometry height="200" width="1480" x="3920" y="7315" as="geometry" />
        </mxCell>
        <mxCell id="p44-admin" deliveryScope="deferred" implementationStatus="not_verified" parent="1" prdRefs="F-44" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;spacing=16;strokeColor=#c62828;fillColor=#fff0f0;fontColor=#a51e1e;strokeWidth=2;" value="&lt;b&gt;模型管理控制台与多供应商策略&lt;/b&gt;&lt;br&gt;按能力选择获批模型 / 本地模型和版本；密钥引用管理&lt;br&gt;项目出域策略、接收方、调用审计；禁止未授权供应商训练&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;暂缓 | F-44&lt;/font&gt;" vertex="1">
          <mxGeometry height="200" width="1480" x="3920" y="7625" as="geometry" />
        </mxCell>
        <mxCell id="p24" deliveryScope="deferred" implementationStatus="not_verified" parent="1" prdRefs="F-24,F-38,F-46" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;spacing=16;strokeColor=#c62828;fillColor=#fff0f0;fontColor=#a51e1e;strokeWidth=2;" value="&lt;b&gt;周期 / 事件 / CI 调度获批任务&lt;/b&gt;&lt;br&gt;计划、事件、审批策略与目标有效期再次检查&lt;br&gt;任务幂等、失败重试、状态可查；调度不等于新审批&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;暂缓 | F-24,F-38,F-46&lt;/font&gt;" vertex="1">
          <mxGeometry height="200" width="1480" x="5760" y="6905" as="geometry" />
        </mxCell>
        <mxCell id="p25" deliveryScope="deferred" implementationStatus="not_verified" parent="1" prdRefs="F-25" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;spacing=16;strokeColor=#c62828;fillColor=#fff0f0;fontColor=#a51e1e;strokeWidth=2;" value="&lt;b&gt;外部报告同步与通知&lt;/b&gt;&lt;br&gt;脱敏后同步获批平台；身份与项目映射可追溯&lt;br&gt;通知失败独立重试，不重复执行任务 / 创建资产&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;暂缓 | F-25&lt;/font&gt;" vertex="1">
          <mxGeometry height="200" width="1480" x="5760" y="7215" as="geometry" />
        </mxCell>
        <mxCell id="mvp-model-policy" deliveryScope="support" implementationStatus="not_verified" parent="1" prdRefs="F-44" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;spacing=16;strokeColor=#98a2b3;fillColor=#ffffff;fontColor=#182230;strokeWidth=2;" value="&lt;b&gt;MVP：一个获批模型与最小数据策略&lt;/b&gt;&lt;br&gt;受控模型配置与密钥引用；按项目限制出域&lt;br&gt;发送前最小化 / 脱敏；记录接收方、模型版本和调用&lt;br&gt;密钥不入提示词 / 日志；未批准数据不外传&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;纳入范围 | F-44&lt;/font&gt;" vertex="1">
          <mxGeometry height="230" width="1480" x="7000" y="5835" as="geometry" />
        </mxCell>
        <mxCell id="mvp-dependencies" deliveryScope="support" implementationStatus="not_verified" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;spacing=16;strokeColor=#98a2b3;fillColor=#ffffff;fontColor=#182230;strokeWidth=2;" value="&lt;b&gt;当前范围：基础依赖&lt;/b&gt;&lt;br&gt;Streamlit + FastAPI + PostgreSQL + 受控文件存储&lt;br&gt;JEV / 获批 LLM；BGE-M3 / Reranker / Milvus；Neo4j&lt;br&gt;知识 Worker 与关系同步 Worker 独立运行；脚本执行器暂缓" vertex="1">
          <mxGeometry height="230" width="1480" x="7000" y="6155" as="geometry" />
        </mxCell>
        <mxCell id="scope-contract" deliveryScope="support" implementationStatus="not_verified" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;spacing=16;strokeColor=#98a2b3;fillColor=#ffffff;fontColor=#182230;strokeWidth=2;" value="&lt;b&gt;按本次要求修订的交付范围&lt;/b&gt;&lt;br&gt;纳入：统一主图、拼写纠错、意图识别、问答分支指代消解、问答、共享 RAG、用例生成、图谱查询。&lt;br&gt;两个独立后台工作流：知识入库 / 版本维护 / 质量准入，以及关系同步 / 维护，均纳入范围。&lt;br&gt;暂缓：脚本生成 / 校验 / 审批 / 运行前门禁 / 隔离执行 / 执行报告，以及其余红色扩展分支。&lt;br&gt;当前用例链路到禅道正式 ID 即可返回；绿色只表示对应代码能力，不等于整个子图或 PRD 已验收。" vertex="1">
          <mxGeometry height="270" width="3200" x="7600" y="6905" as="geometry" />
        </mxCell>
        <mxCell id="scope-acceptance" deliveryScope="support" implementationStatus="not_verified" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;spacing=16;strokeColor=#98a2b3;fillColor=#ffffff;fontColor=#182230;strokeWidth=2;" value="&lt;b&gt;当前范围检查与验收方向&lt;/b&gt;&lt;br&gt;输入 → 拼写纠错 → 意图识别 → 路由；仅 dialogue 经指代消解 → 问答，其他业务不经过该模型。&lt;br&gt;问答：直接回答或项目授权检索，引用本次证据；证据不足 / 服务失败明确区分。&lt;br&gt;用例：授权来源、正负边界、人工评审、真实禅道 ID；写入失败保留草稿，不推进脚本链路。&lt;br&gt;图谱：受限查询、先授权后统计、来源 / 时间口径与撤权校验；两个后台流程独立可恢复。&lt;br&gt;暂缓节点保持红色；部分实现节点不整体标绿；新补 PRD 节点仍按现有范围保留。" vertex="1">
          <mxGeometry height="340" width="3200" x="7600" y="7275" as="geometry" />
        </mxCell>
        <mxCell id="p13" deliveryScope="deferred" implementationStatus="not_verified" parent="1" prdRefs="F-12,F-13" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;spacing=16;strokeColor=#c62828;fillColor=#fff0f0;fontColor=#a51e1e;strokeWidth=2;" value="&lt;b&gt;风险追踪、组合覆盖与重复检查&lt;/b&gt;&lt;br&gt;需求 / 风险 -&amp;gt; 策略 / 用例追踪；Pairwise 与因子组合覆盖&lt;br&gt;对比已批准用例减少重复；缺口提交评审&lt;br&gt;组合覆盖不能替代业务预期验证&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;暂缓 | F-12,F-13&lt;/font&gt;" vertex="1">
          <mxGeometry height="200" width="1180" x="5080" y="4965" as="geometry" />
        </mxCell>
        <mxCell id="p11" deliveryScope="deferred" implementationStatus="not_verified" parent="1" prdRefs="F-11" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;spacing=16;strokeColor=#c62828;fillColor=#fff0f0;fontColor=#a51e1e;strokeWidth=2;" value="&lt;b&gt;设计文件与授权操作证据接入&lt;/b&gt;&lt;br&gt;扩展需求 / 开发澄清、设计文件、页面操作记录&lt;br&gt;保留来源、版本、项目、引用位置；冲突 / 过期提示确认&lt;br&gt;生成用例不得把提取结果冒充已验证业务事实&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;暂缓 | F-11&lt;/font&gt;" vertex="1">
          <mxGeometry height="200" width="1180" x="6520" y="4965" as="geometry" />
        </mxCell>
        <mxCell id="enterprise-crosscutting-heading" deliveryScope="deferred" implementationStatus="not_verified" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;spacing=16;strokeColor=#c62828;fillColor=#fff0f0;fontColor=#a51e1e;strokeWidth=2;" value="&lt;b&gt;横向企业级横切能力目标（横跨业务子图与后台工作流；当前暂缓交付）&lt;/b&gt;" vertex="1">
          <mxGeometry height="65" width="10440" x="580" y="10435" as="geometry" />
        </mxCell>
        <mxCell id="enterprise-crosscutting-1" deliveryScope="deferred" implementationStatus="not_verified" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;spacing=16;strokeColor=#c62828;fillColor=#fff0f0;fontColor=#a51e1e;strokeWidth=2;" value="&lt;b&gt;[暂缓] 安全、身份与数据治理&lt;/b&gt;&lt;br&gt;企业 SSO 与身份/成员生命周期；租户、项目、会话和服务身份隔离；权限矩阵与即时撤权；API 限流/防重放；KMS/Vault 密钥引用与轮换；数据分级、加密、脱敏、驻留、保留/删除；合规审计、依赖/镜像扫描与 SBOM。" vertex="1">
          <mxGeometry height="155" width="10440" x="580" y="10515" as="geometry" />
        </mxCell>
        <mxCell id="enterprise-crosscutting-2" deliveryScope="deferred" implementationStatus="not_verified" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;spacing=16;strokeColor=#c62828;fillColor=#fff0f0;fontColor=#a51e1e;strokeWidth=2;" value="&lt;b&gt;[暂缓] Agent 与 AI 治理&lt;/b&gt;&lt;br&gt;所有 AI 节点输入/输出边界、截止时间和明确终态；工具/受保护数据/副作用路径按服务端授权白名单 → 模型受限提议 → 执行前后确定性复核三道门治理；意图识别仅作候选路由；工具注册、Schema、逐次授权审计、模型/Prompt 版本、评估与预算。" vertex="1">
          <mxGeometry height="155" width="10440" x="580" y="10690" as="geometry" />
        </mxCell>
        <mxCell id="enterprise-crosscutting-3" deliveryScope="deferred" implementationStatus="not_verified" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;spacing=16;strokeColor=#c62828;fillColor=#fff0f0;fontColor=#a51e1e;strokeWidth=2;" value="&lt;b&gt;[暂缓] 可观测性与运维&lt;/b&gt;&lt;br&gt;统一 task_id/trace_id 的结构化日志、Metrics、分布式 Trace；AI 决策元数据含节点/路由/授权结果、稳定错误码、结果类别、停止原因、耗时/用量及证据版本；禁止记录隐藏思维链，原始 Prompt、完整工具参数/返回体与答案正文默认不入运行日志；其余仪表盘、告警、SLI/SLO、Runbook 与复盘待交付。" vertex="1">
          <mxGeometry height="155" width="10440" x="580" y="10865" as="geometry" />
        </mxCell>
        <mxCell id="enterprise-crosscutting-4" deliveryScope="deferred" implementationStatus="not_verified" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;spacing=16;strokeColor=#c62828;fillColor=#fff0f0;fontColor=#a51e1e;strokeWidth=2;" value="&lt;b&gt;[暂缓] 可靠性与集成治理&lt;/b&gt;&lt;br&gt;依赖瞬时错误：有限次数指数退避（可加抖动）；可修复结构/参数错误：脱敏结构化错误反馈模型并独立限次/限 Token/限时自修复；权限和业务拒绝不重试；外部写入结果未知先核实/对账。显式状态机、幂等、熔断、降级、死信、Outbox 与连接器恢复待交付。" vertex="1">
          <mxGeometry height="155" width="10440" x="580" y="11040" as="geometry" />
        </mxCell>
        <mxCell id="enterprise-crosscutting-5" deliveryScope="deferred" implementationStatus="not_verified" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;spacing=16;strokeColor=#c62828;fillColor=#fff0f0;fontColor=#a51e1e;strokeWidth=2;" value="&lt;b&gt;[暂缓] 数据一致性与灾备&lt;/b&gt;&lt;br&gt;权威数据与派生索引/图谱的版本、激活、撤回、删除传播和对账；缓存失效、Schema 迁移与兼容；PostgreSQL、原件/对象存储、Milvus、Neo4j 的备份恢复顺序、校验、RPO/RTO、业务降级和定期恢复演练。" vertex="1">
          <mxGeometry height="155" width="10440" x="580" y="11215" as="geometry" />
        </mxCell>
        <mxCell id="enterprise-crosscutting-6" deliveryScope="deferred" implementationStatus="not_verified" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;spacing=16;strokeColor=#c62828;fillColor=#fff0f0;fontColor=#a51e1e;strokeWidth=2;" value="&lt;b&gt;[暂缓] 工程交付、质量与容量&lt;/b&gt;&lt;br&gt;Dev/Test/Staging/Prod 隔离；配置中心/Feature Flag；CI/CD、审批、灰度、回滚、数据库迁移及 IaC；单元/集成/E2E/契约/安全/性能/AI 回归门禁；压测与容量规划，按租户配额、成本归因、背压及弹性扩缩容。" vertex="1">
          <mxGeometry height="155" width="10440" x="580" y="11390" as="geometry" />
