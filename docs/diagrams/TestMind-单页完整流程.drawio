        <mxCell id="s1" deliveryScope="core" implementationStatus="not_verified" parent="1" prdRefs="F-01,F-03,F-11,F-46" previousValue="&lt;div style='line-height:1.3'&gt;&lt;b&gt;选择数据来源&lt;/b&gt;&lt;br&gt;&lt;font color='#344054'&gt;读：requirement_id, api_spec_id, existing_case_id, project_id&lt;br&gt;写：source_snapshot, source_version&lt;br&gt;API：GET requirements; GET /api/v1/test-cases&lt;/font&gt;&lt;br&gt;&lt;font color='#667085'&gt;新用例走需求/API；脚本生成可直接选禅道已有用例&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=15;spacing=16;fillColor=#ffffff;strokeColor=#98a2b3;strokeWidth=2;shadow=0;fontColor=#182230;" value="&lt;b&gt;选择来源、解析并保存版本快照&lt;/b&gt;&lt;br&gt;需求文本 / Markdown、Swagger/OpenAPI、Postman&lt;br&gt;真实禅道授权项目 / 需求 / 用例读取；记录 ID / 版本 / 时间&lt;br&gt;提取参数、响应、鉴权和约束；保留引用位置&lt;br&gt;冲突 / 解析失败转补充；凭据仅使用受控引用&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;纳入范围 | F-01,F-03,F-11,F-46&lt;/font&gt;" vertex="1">
          <mxGeometry height="180" width="620" x="2420" y="3145" as="geometry" />
        </mxCell>
        <mxCell id="joWmhu-DPa3gcet3B-iL-21" edge="1" parent="1" source="s2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" target="r9" value="&lt;span style=&quot;color: rgb(71, 84, 103); font-family: &amp;quot;Microsoft YaHei&amp;quot;; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: nowrap; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;按需调用：历史用例 / 缺陷&lt;/span&gt;">
          <mxGeometry relative="1" x="-0.0026" y="-10" as="geometry">
            <mxPoint as="offset" />
            <mxPoint x="2160" y="3474.666666666667" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s2" deliveryScope="core" implementationStatus="not_verified" parent="1" prdRefs="F-11,F-12" previousValue="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b&gt;[AI] 提取测试因子&lt;/b&gt;&lt;br&gt;输入：requirement_text / API schema / EvidenceBundle&lt;br&gt;按需调用 RAG 入口检索历史用例与缺陷；返回后继续提取&lt;br&gt;输出：preconditions / inputs / boundaries / risks / assertions&lt;br&gt;目标跨子图调用待实施，不重新进入主图路由&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=15;spacing=16;fillColor=#ffffff;strokeColor=#98a2b3;strokeWidth=2;shadow=0;fontColor=#182230;" value="&lt;b&gt;[AI] 提取因子、边界、风险与业务断言&lt;/b&gt;&lt;br&gt;直接消费任务来源快照和澄清记录&lt;br&gt;按需调用共享 RAG，检索历史缺陷和已批准用例&lt;br&gt;证据返回本子图；引用来源，不重新进入主图路由" vertex="1">
          <mxGeometry height="180" width="620" x="2420" y="3385" as="geometry" />
        </mxCell>
        <mxCell id="s3" deliveryScope="core" implementationStatus="not_verified" parent="1" prdRefs="F-12,F-13,F-45" previousValue="&lt;div style='line-height:1.3'&gt;&lt;b&gt;[AI] 生成用例草稿&lt;/b&gt;&lt;br&gt;&lt;font color='#344054'&gt;读：test_factors, project_rules, case_template&lt;br&gt;写：case_draft, coverage_matrix, citations&lt;br&gt;API：POST /api/v1/test-cases/generate&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=15;spacing=16;fillColor=#ffffff;strokeColor=#98a2b3;strokeWidth=2;shadow=0;fontColor=#182230;" value="&lt;b&gt;[AI] 生成待审用例与覆盖检查&lt;/b&gt;&lt;br&gt;每例：前置、步骤 / 参数、预期 / 断言、来源、风险&lt;br&gt;展示需求 / 因子覆盖与缺口；不伪装已验证事实&lt;br&gt;至少一组可核查的正向、负向和边界样例&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;纳入范围 | F-12,F-13,F-45&lt;/font&gt;" vertex="1">
          <mxGeometry height="180" width="620" x="2420" y="3625" as="geometry" />
        </mxCell>
        <mxCell id="s4" deliveryScope="core" implementationStatus="not_verified" parent="1" prdRefs="F-13,F-45" previousValue="&lt;div style='line-height:1.3'&gt;&lt;b&gt;[HITL] 用例评审与修改&lt;/b&gt;&lt;br&gt;&lt;font color='#344054'&gt;读：case_draft, coverage_matrix, reviewer&lt;br&gt;写：decision, comments, approved_case_version&lt;br&gt;API：POST /api/v1/approvals/{id}/decision&lt;/font&gt;&lt;br&gt;&lt;font color='#667085'&gt;拒绝或修改后回草稿；保留评审版本&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=15;spacing=16;fillColor=#ffffff;strokeColor=#98a2b3;strokeWidth=2;shadow=0;fontColor=#182230;" value="&lt;b&gt;[HITL] 用例评审、编辑与确认&lt;/b&gt;&lt;br&gt;逐条接受 / 编辑 / 驳回；留责任人及评审版本&lt;br&gt;按项目验证规则核查来源、业务预期与覆盖&lt;br&gt;MVP 人工核查；API/UI dry-run 后续独立受控执行&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;纳入范围 | F-13,F-45&lt;/font&gt;" vertex="1">
          <mxGeometry height="180" width="620" x="2420" y="3865" as="geometry" />
        </mxCell>
        <mxCell id="s5" deliveryScope="core" implementationStatus="not_verified" parent="1" prdRefs="F-01,F-02,F-03" previousValue="&lt;div style='line-height:1.3'&gt;&lt;b&gt;写入禅道用例&lt;/b&gt;&lt;br&gt;&lt;font color='#344054'&gt;读：approved_case_version, project_id, idempotency_key&lt;br&gt;写：zentao_case_id, sync_status&lt;br&gt;API：POST /api/v1/integrations/zentao/test-cases&lt;/font&gt;&lt;br&gt;&lt;font color='#667085'&gt;幂等写入；失败保留草稿和错误&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=15;spacing=16;fillColor=#ffffff;strokeColor=#98a2b3;strokeWidth=2;shadow=0;fontColor=#182230;" value="&lt;b&gt;发布已确认用例到真实禅道&lt;/b&gt;&lt;br&gt;写入需授权 + 已批准版本 + 幂等键&lt;br&gt;保存正式 zentao_case_id；成功后才能继续&lt;br&gt;失败留草稿、错误和同步状态；重试不重复创建&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;纳入范围 | F-01,F-02,F-03&lt;/font&gt;" vertex="1">
          <mxGeometry height="180" width="620" x="2420" y="4105" as="geometry" />
        </mxCell>
        <mxCell id="s6" deliveryScope="deferred" implementationStatus="not_verified" parent="1" prdRefs="F-14,F-46" previousValue="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b&gt;脚本上下文组装&lt;/b&gt;&lt;br&gt;输入：approved_case / framework_context / env_profile&lt;br&gt;按需调用 RAG 入口检索框架规范与脚本示例，接收 EvidenceBundle&lt;br&gt;输出：generation_context；再由下方 AI 节点生成脚本&lt;br&gt;目标跨子图调用待实施，不调用问答 Agent&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=15;spacing=16;fillColor=#fff0f0;strokeColor=#c62828;strokeWidth=2;shadow=0;fontColor=#a51e1e;" value="&lt;b&gt;脚本上下文组装&lt;/b&gt;&lt;br&gt;正式用例版本、受控 pytest/HTTPX 模板&lt;br&gt;环境地址、鉴权引用、测试参数和业务断言&lt;br&gt;MVP 显式模板；RAG 示例检索暂缓&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;暂缓 | F-14,F-46&lt;/font&gt;" vertex="1">
          <mxGeometry height="180" width="620" x="3300" y="3145" as="geometry" />
        </mxCell>
        <mxCell id="s7" deliveryScope="deferred" implementationStatus="not_verified" parent="1" prdRefs="F-14,F-15" previousValue="&lt;div style='line-height:1.3'&gt;&lt;b&gt;[AI] pytest 脚本生成&lt;/b&gt;&lt;br&gt;&lt;font color='#344054'&gt;读：generation_context, framework_version&lt;br&gt;写：script_draft, diff, dependencies, risk_flags&lt;br&gt;API：POST /api/v1/scripts/generate&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=15;spacing=16;fillColor=#fff0f0;strokeColor=#c62828;strokeWidth=2;shadow=0;fontColor=#a51e1e;" value="&lt;b&gt;[AI] 生成 pytest/HTTPX API 脚本&lt;/b&gt;&lt;br&gt;关联用例 / 来源版本；展示依赖、差异和风险&lt;br&gt;可查看、编辑、下载；保留前后置与业务断言&lt;br&gt;禁止虚构凭据、删除断言或放宽预期制造通过&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;暂缓 | F-14,F-15&lt;/font&gt;" vertex="1">
          <mxGeometry height="180" width="620" x="3300" y="3385" as="geometry" />
        </mxCell>
        <mxCell id="s8" deliveryScope="deferred" implementationStatus="not_verified" parent="1" prdRefs="F-15,F-16" previousValue="&lt;div style='line-height:1.3'&gt;&lt;b&gt;静态校验与风险检查&lt;/b&gt;&lt;br&gt;&lt;font color='#344054'&gt;读：script_draft, policy, allowlist&lt;br&gt;写：lint_result, import_result, risk_findings&lt;br&gt;API：无（LangGraph 内部节点）&lt;/font&gt;&lt;br&gt;&lt;font color='#667085'&gt;拦截任意 shell 及越权文件/网络操作&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=15;spacing=16;fillColor=#fff0f0;strokeColor=#c62828;strokeWidth=2;shadow=0;fontColor=#a51e1e;" value="&lt;b&gt;静态校验与风险检查&lt;/b&gt;&lt;br&gt;检查语法、依赖、前后置、数据提取和业务断言&lt;br&gt;文件 / 网络 / 命令限制与目标环境白名单&lt;br&gt;校验失败回草稿；静态校验不代替运行隔离&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;暂缓 | F-15,F-16&lt;/font&gt;" vertex="1">
          <mxGeometry height="180" width="620" x="3300" y="3625" as="geometry" />
        </mxCell>
        <mxCell id="s9" deliveryScope="deferred" implementationStatus="not_verified" parent="1" prdRefs="F-09,F-15,F-16" previousValue="&lt;div style='line-height:1.3'&gt;&lt;b&gt;[HITL] 人工确认脚本&lt;/b&gt;&lt;br&gt;&lt;font color='#344054'&gt;读：script_hash, diff, environment_profile, reviewer_id&lt;br&gt;写：approval_id, approved_hash, approval_state&lt;br&gt;API：POST /api/v1/approvals/{id}/decision&lt;/font&gt;&lt;br&gt;&lt;font color='#667085'&gt;脚本内容变化后原审批失效&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=15;spacing=16;fillColor=#fff0f0;strokeColor=#c62828;strokeWidth=2;shadow=0;fontColor=#a51e1e;" value="&lt;b&gt;[HITL] 审批脚本与执行范围&lt;/b&gt;&lt;br&gt;确认内容摘要、用例版本、环境、数据与资源限制&lt;br&gt;保存 approval_id / approved_hash / reviewer&lt;br&gt;编辑后审批失效；拒绝可查；重提须再审批&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;暂缓 | F-09,F-15,F-16&lt;/font&gt;" vertex="1">
          <mxGeometry height="180" width="620" x="3300" y="3865" as="geometry" />
        </mxCell>
        <mxCell id="s10" deliveryScope="deferred" implementationStatus="not_verified" parent="1" prdRefs="F-16,F-47,F-48" previousValue="&lt;div style='line-height:1.3'&gt;&lt;b&gt;隔离 Worker 执行&lt;/b&gt;&lt;br&gt;&lt;font color='#344054'&gt;读：approved_hash, run_id, env_id, timeout, limits&lt;br&gt;写：exit_code, junit_xml, stdout_ref, stderr_ref&lt;br&gt;API：POST /api/v1/runs; GET /api/v1/runs/{id}&lt;/font&gt;&lt;br&gt;&lt;font color='#667085'&gt;只运行已批准 hash 对应的脚本&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=15;spacing=16;fillColor=#fff0f0;strokeColor=#c62828;strokeWidth=2;shadow=0;fontColor=#a51e1e;" value="&lt;b&gt;隔离 Worker 执行&lt;/b&gt;&lt;br&gt;仅执行获批内容；复核目标、时长、资源、网络范围&lt;br&gt;每个 run 独立变量、工作目录、数据与产物&lt;br&gt;固定输入样例；清理临时资源并记录结果&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;暂缓 | F-16,F-47,F-48&lt;/font&gt;" vertex="1">
          <mxGeometry height="170" width="620" x="3300" y="4355" as="geometry" />
        </mxCell>
        <mxCell id="s11" deliveryScope="deferred" implementationStatus="not_verified" parent="1" prdRefs="F-03,F-17,F-45" previousValue="&lt;div style='line-height:1.3'&gt;&lt;b&gt;指标与报告&lt;/b&gt;&lt;br&gt;&lt;font color='#344054'&gt;读：junit_xml, locust_report?, zap_report?, run_metadata&lt;br&gt;写：pass_rate, performance, security, report_id&lt;br&gt;API：GET /api/v1/runs/{id}/report&lt;/font&gt;&lt;br&gt;&lt;font color='#667085'&gt;性能/安全未执行时显示未采集&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=15;spacing=16;fillColor=#fff0f0;strokeColor=#c62828;strokeWidth=2;shadow=0;fontColor=#a51e1e;" value="&lt;b&gt;结果、证据与基础执行报告&lt;/b&gt;&lt;br&gt;通过 / 断言失败 / 收集错误 / 环境错误 / 跳过 / 超时&lt;br&gt;脱敏响应、状态码、耗时、断言和原始日志&lt;br&gt;通过率可追溯；跳过单列；未完成不视为通过&lt;br&gt;性能 / 安全未运行显示未采集&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;暂缓 | F-03,F-17,F-45&lt;/font&gt;" vertex="1">
          <mxGeometry height="180" width="620" x="3300" y="4595" as="geometry" />
        </mxCell>
        <mxCell id="s12" deliveryScope="deferred" implementationStatus="not_verified" parent="1" prdRefs="F-02,F-18,F-19,F-20,F-45" previousValue="&lt;div style='line-height:1.3'&gt;&lt;b&gt;[HITL] 人工结论与缺陷协作&lt;/b&gt;&lt;br&gt;&lt;font color='#344054'&gt;读：failure_evidence, related_case, reviewer_id&lt;br&gt;写：confirmed_bug, revised_case, issue_id, decision&lt;br&gt;API：POST /api/v1/feedback/decisions&lt;/font&gt;&lt;br&gt;&lt;font color='#667085'&gt;人工确认后才创建正式缺陷单&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=15;spacing=16;fillColor=#fff0f0;strokeColor=#c62828;strokeWidth=2;shadow=0;fontColor=#a51e1e;" value="&lt;b&gt;[HITL] 失败结论、修订与缺陷确认&lt;/b&gt;&lt;br&gt;按证据判断；关联已有缺陷或生成缺陷草稿&lt;br&gt;正式提单单独人工确认，保存禅道 ID&lt;br&gt;脚本执行审批不等于提单或共享入库审批&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;暂缓 | F-02,F-18,F-19,F-20,F-45&lt;/font&gt;" vertex="1">
          <mxGeometry height="180" width="620" x="3300" y="4855" as="geometry" />
        </mxCell>
        <mxCell id="s13" deliveryScope="deferred" implementationStatus="partial" parent="1" prdRefs="F-17,F-31,F-32" previousValue="&lt;div style='line-height:1.3'&gt;&lt;b&gt;短反馈与长反馈&lt;/b&gt;&lt;br&gt;&lt;font color='#344054'&gt;读：task_state, human_decision, run_evidence&lt;br&gt;写：short_feedback, long_feedback, audit_events&lt;br&gt;API：GET /api/v1/tasks/{id}; POST /api/v1/feedback&lt;/font&gt;&lt;br&gt;&lt;font color='#667085'&gt;短反馈报进度；长反馈带实际结果、证据与审批&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=15;spacing=16;fillColor=#fff0f0;strokeColor=#c62828;strokeWidth=2;shadow=0;fontColor=#a51e1e;" value="&lt;b&gt;执行终态与最终反馈&lt;/b&gt;&lt;br&gt;成功、失败、超时、拒绝、部分完成均记真实状态&lt;br&gt;返回用例 / 脚本版本、禅道 ID、run_id、报告、审批&lt;br&gt;MVP 回流状态显示未启用；不报虚假闭环&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;暂缓 | F-17,F-31,F-32&lt;/font&gt;" vertex="1">
          <mxGeometry height="180" width="620" x="3300" y="5115" as="geometry" />
        </mxCell>
        <mxCell id="s16" deliveryScope="deferred" implementationStatus="not_verified" parent="1" prdRefs="F-24" previousValue="&lt;div style='line-height:1.3'&gt;&lt;b&gt;N8N 定时回归&lt;/b&gt;&lt;br&gt;&lt;font color='#344054'&gt;读：approved_suite_ids, schedule, env, idempotency_key&lt;br&gt;写：workflow_run_id, run_ids, notification_ref&lt;br&gt;API：签名 webhook：POST /api/v1/webhooks/n8n/run&lt;/font&gt;&lt;br&gt;&lt;font color='#667085'&gt;N8N 只调度预批准套件，不批准新脚本&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=15;spacing=16;fillColor=#fff0f0;strokeColor=#c62828;strokeWidth=2;shadow=0;fontColor=#a51e1e;" value="&lt;div style='line-height:1.3'&gt;&lt;b&gt;N8N 定时回归&lt;/b&gt;&lt;br&gt;&lt;font&gt;读：approved_suite_ids, schedule, env, idempotency_key&lt;br&gt;写：workflow_run_id, run_ids, notification_ref&lt;br&gt;API：签名 webhook：POST /api/v1/webhooks/n8n/run&lt;/font&gt;&lt;br&gt;&lt;font&gt;N8N 只调度预批准套件，不批准新脚本&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;暂缓 | F-24&lt;/font&gt;" vertex="1">
