        <mxCell id="r14" deliveryScope="core" implementationStatus="completed" parent="1" prdRefs="F-07" previousValue="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b&gt;[已实现] 统一问答输出&lt;/b&gt;&lt;br&gt;answer / citations / status / insufficient_evidence / last_error&lt;br&gt;仅追加一条 AIMessage；检索内部状态与权限对象不返回主图&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=15;spacing=16;fillColor=#dff3e5;strokeColor=#5c9f73;strokeWidth=2;shadow=0;fontColor=#182230;" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b&gt;[已实现] 统一问答输出&lt;/b&gt;&lt;br&gt;answer / citations / status / insufficient_evidence / last_error&lt;br&gt;仅追加一条 AIMessage；检索内部状态与权限对象不返回主图&lt;/div&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;纳入范围 | F-07&lt;/font&gt;" vertex="1">
