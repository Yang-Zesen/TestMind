        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="demo-p4-status" parent="1" vertex="1" implementationStatus="demo_verified" deliveryScope="support" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;spacing=14;fillColor=#dff3e5;strokeColor=#348054;fontColor=#182230;" value="&lt;b&gt;2026-10-14 本地 P4 图谱闭环与 P0-P6 整体审查&lt;/b&gt;&lt;br&gt;本地模拟项目/成员/需求/用例/缺陷；持久化事件、独立分页水位、删除/撤权；真实 PG→Neo4j&lt;br&gt;私有查询子图接主图/工作台；受限实体/关系/当前指标；PG 权威版本/关系复核、历史结果撤权&lt;br&gt;独立 graph-worker；对账修复、隔离代际重建、最新快照/租约/维护授权校验后切换&lt;br&gt;来源登记时间/维护者水位；无历史不推断趋势；旧代际至少保留 24 小时，仅清理预览&lt;br&gt;P5/P6 本地闭环与限制见本地验收 SOP；生产身份和真实禅道仍未验收。">
          <mxGeometry x="6300" y="540" width="2000" height="235" as="geometry" />
        </mxCell>
        <mxCell id="demo-p2-p3-status" parent="1" vertex="1" implementationStatus="demo_verified" deliveryScope="support" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;spacing=14;fillColor=#dff3e5;strokeColor=#348054;fontColor=#182230;" value="&lt;b&gt;2026-10-14 本地 P2/P3 实测范围（覆盖旧 P0/P1 说明中的后续项）&lt;/b&gt;&lt;br&gt;真实 PG/Milvus/BGE-M3/Reranker；共享 EvidenceBundle、前后权限/版本复核、摘录回答与引用跳转&lt;br&gt;独立知识 Worker；有界解析、质量/索引 ready、显式激活、替换/reindex/撤回；模拟增量来源与 source_sync&lt;br&gt;需求/OpenAPI 规则草稿；来源快照、逐条编辑/批准/拒绝，改稿失效审批、过期来源/证据阻断发布&lt;br&gt;持久化操作账本 + 模拟禅道 DEMO-ID；并发幂等、未知结果待核实、禁止盲目重发&lt;br&gt;P4-P6 本地演示验收见对应 SOP；真实企业身份、真实生成模型质量及真实禅道读写仍未验收。">
          <mxGeometry x="6300" y="270" width="2000" height="245" as="geometry" />
        </mxCell>
        <mxCell id="demo-p0-p1-status" parent="1" vertex="1" implementationStatus="demo_verified" deliveryScope="support" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;spacing=14;fillColor=#dff3e5;strokeColor=#348054;fontColor=#182230;" value="&lt;b&gt;2026-10-14 本地 P0/P1 实测范围&lt;/b&gt;&lt;br&gt;两用户/两项目 PG 演示授权与撤权；任务/事件/审批 version/hash 持久化与幂等&lt;br&gt;独立 PG 租约 Worker、过期 token 拒绝写回、累计截止时间；澄清恢复/取消/SSE 补读&lt;br&gt;复用主图/direct 子图/禅道工具工厂；三道门、两类有限恢复、结构化停止原因，不记录隐藏思维链&lt;br&gt;TestMind Compose：PG/Milvus/etcd/MinIO/Neo4j；API/Worker 独立启动与重启验证&lt;br&gt;模型/JEV/禅道数据使用离线演示适配器；企业身份、真实聊天 MCP、外部写入及完整资产审批仍待后续验收。证据见 P0-P1 本地验收 SOP。">
          <mxGeometry x="6300" y="20" width="2000" height="235" as="geometry" />
        </mxCell>
