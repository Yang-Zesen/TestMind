        direction TB
    T_TIMER[周期 / 事件 / CI 触发] --> T_CHECK[计划、授权、批准版本与有效期复核]
    T_CHECK --> T_VALID{任务仍有效?}
    T_VALID -->|否| T_BLOCK[拒绝派发与审计]
    T_VALID -->|是| T_DISPATCH[幂等登记与队列派发]
    T_DISPATCH --> T_WORKFLOW[[对应业务子图 / 运行门禁]]
    T_WORKFLOW --> T_RESULT[业务结果与报告评审]
    T_RESULT --> T_NOTICE[脱敏、平台映射与受控通知]
    T_NOTICE --> T_SENT{同步成功?}
    T_SENT -->|否| T_RETRY[只重试通知，不重跑业务]
    T_RETRY --> T_NOTICE
    T_SENT -->|是| T_DONE[保存外部引用与同步状态]
    class T_TIMER,T_CHECK,T_VALID,T_BLOCK,T_DISPATCH,T_WORKFLOW,T_RESULT,T_NOTICE,T_SENT,T_RETRY,T_DONE deferred;

    end
    end
    subgraph CROSSCUTTING[横切企业能力：作用于 API、全部子图及 Worker，完整层暂缓]
        direction TB
    subgraph X_L1[安全、身份与数据治理]
        direction LR
        X_SSO[企业身份 / 权限矩阵] --- X_SECRET[密钥、脱敏与数据生命周期] --- X_SUPPLY[合规与供应链安全]
    end
    subgraph X_L2[Agent 与 AI 治理]
        direction LR
        X_TOOLS[仅工具 / 受保护数据 / 副作用：服务端授权白名单 → 受限提议 → 执行前后复核] --- X_BOUNDS[所有 AI 节点：输入 / 输出边界、截止时间、终态] --- X_MODEL[模型 / Prompt 版本与回滚] --- X_EVAL[评估、护栏与 Token 预算]
    end
    subgraph X_L3[可观测性与运维]
        direction LR
        X_TRACE[结构化决策事件、结果 / 停止原因 / 错误码；禁止隐藏思维链] --- X_ALERT[SLI / SLO、仪表盘与告警] --- X_OPS[Runbook、值班与复盘]
    end
    subgraph X_L4[可靠性与集成治理]
        direction LR
        X_STATE[状态机、幂等与任务恢复] --- X_RETRY[依赖指数退避重试与 AI 结构化自修复分开限次；未知写结果先核实] --- X_ADAPTER[Outbox、补偿与连接器契约]
    end
    subgraph X_L5[数据一致性与灾备]
        direction LR
        X_VERSION[版本、激活、撤回与对账] --- X_MIGRATE[缓存失效与 Schema 兼容] --- X_BACKUP[备份恢复、RPO / RTO 与演练]
    end
    subgraph X_L6[工程交付、质量与容量]
        direction LR
        X_RELEASE[环境、配置、CI/CD 与灰度] --- X_TEST[测试与 AI 评估发布门禁] --- X_CAPACITY[配额、压测、成本与弹性]
    end
    X_L1 ~~~ X_L2
    X_L2 ~~~ X_L3
    X_L3 ~~~ X_L4
    X_L4 ~~~ X_L5
    X_L5 ~~~ X_L6
    class X_SSO,X_SECRET,X_SUPPLY,X_TOOLS,X_BOUNDS,X_MODEL,X_EVAL,X_TRACE,X_ALERT,X_OPS,X_STATE,X_RETRY,X_ADAPTER,X_VERSION,X_MIGRATE,X_BACKUP,X_RELEASE,X_TEST,X_CAPACITY deferred;
    class X_TOOLS,X_BOUNDS,X_TRACE,X_RETRY scope;
