        <mxCell id="mvp-guide-6" connectable="0" deliveryScope="overview" implementationStatus="not_verified" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;spacing=16;strokeColor=#98a2b3;fillColor=#ffffff;fontColor=#182230;strokeWidth=2;" value="&lt;b&gt;06  结果与状态&lt;/b&gt;&lt;br&gt;来源 / 版本 / 审计 / 证据&lt;br&gt;统一反馈；刷新与恢复" vertex="1">
          <mxGeometry height="145" width="920" x="5180" y="270" as="geometry" />
        </mxCell>
        <mxCell id="joWmhu-DPa3gcet3B-iL-26" edge="1" parent="1" source="mvp-entry" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;dashed=1;strokeColor=#FF3333;strokeWidth=1.6;" target="p39">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="5030" y="1335" />
              <mxPoint x="5030" y="2480" />
